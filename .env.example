# ==============================================================================
# AquaFlow Backend Environment Template (.env.example)
# Copy to '.env' for local development, or '.env.production' on the server.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Profile Settings
# ------------------------------------------------------------------------------
# Active Spring Profile: 'dev' for local H2 in-memory DB, 'prod' for PostgreSQL
SPRING_PROFILES_ACTIVE=dev

# Server Port:
# Local dev default: 8080
# Production on agama-core VPS: 8082 (avoids conflict with GLPI on 8080 & Vaultwarden on 8081)
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=aquaflow
# Production host is 'postgres' inside docker network, or 'localhost' when running standalone
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aquaflow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-postgres-password

# ------------------------------------------------------------------------------
# MQTT Mosquitto Broker Configuration
# ------------------------------------------------------------------------------
# Host is 'tcp://mosquitto:1883' in Docker, or 'tcp://localhost:1883' locally
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ------------------------------------------------------------------------------
# Security, Tokens & Keys
# ------------------------------------------------------------------------------
# JWT signing key (minimum 256 bits / 32 bytes base64-encoded string)
JWT_SECRET=your-jwt-secret-at-least-256-bits-long-base64-encoded
JWT_EXPIRATION_MS=86400000

# LoRaWAN / ChirpStack webhook secret
LORAWAN_WEBHOOK_SECRET=your-webhook-secret

# ArvaCore field gateway -> backend telemetry key (generate e.g. `openssl rand -hex 32`)
ARVACORE_GATEWAY_INGEST_KEY=replace-with-random-gateway-key

# Allowed CORS origins (comma-separated). Use target domain for production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://api-aquaflow.gladwindr.me

# ------------------------------------------------------------------------------
# Logging & Timezone
# ------------------------------------------------------------------------------
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
TZ=Asia/Manila

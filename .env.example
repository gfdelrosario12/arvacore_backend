# ==============================================================================
# ArvaCore Backend Developer Local Execution Template (.env.example)
# Copy to '.env' when running Spring Boot standalone without Docker Compose.
# ==============================================================================

# Application & Profile Settings
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Local PostgreSQL Database Configuration
POSTGRES_DB=aquaflow
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aquaflow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-postgres-password

# Local Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Local MQTT Mosquitto Broker Configuration
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Security & Authentication
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION_MS=86400000
LORAWAN_WEBHOOK_SECRET=your-webhook-secret
# ArvaCore gateway -> backend telemetry key (generate e.g. `openssl rand -hex 32`; never put in ArvaNet)
ARVACORE_GATEWAY_INGEST_KEY=replace-with-random-gateway-key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

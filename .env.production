# =============================================================================
# AquaFlow Backend — Production Environment Template
# Copy this file to .env.production on the server and fill in real values.
# =============================================================================

# Application & Profile
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082

# PostgreSQL (used by both postgres container and Spring Boot)
POSTGRES_DB=aquaflow
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/aquaflow
SPRING_DATASOURCE_USERNAME=postgres
# Password is read from Docker secret file — see secrets/db_password.txt

# MQTT Mosquitto Broker
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Security & Authentication
# JWT & webhook secrets are read from Docker secret files
JWT_EXPIRATION_MS=86400000
ARVACORE_GATEWAY_INGEST_KEY=replace-with-random-gateway-key
CORS_ALLOWED_ORIGINS=https://api-aquaflow.gladwindr.me

# Logging
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO

# Timezone
TZ=Asia/Manila

